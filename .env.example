# AI 启智课后端 · 环境变量模板
# 复制为 .env 后填写。生产环境该文件必须 chmod 600，且绝不能进版本库。

# ── 运行时 ────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=3020

# ── 数据库（独立库，不碰 301_group）──────────────────────
# 密码用 openssl rand -base64 24 生成，注意 URL 里的特殊字符要 percent-encode
DATABASE_URL="mysql://aiq_user:<PASSWORD>@127.0.0.1:3306/aiq_course"

# ── Redis（限流用；db1 与 301 隔离）──────────────────────
REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_PREFIX="aiq:"

# ── 会话 ─────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET="<AT_LEAST_32_CHARS_RANDOM>"
COOKIE_NAME="aiq_session"
COOKIE_SECURE=true
SESSION_TTL_DAYS=7

# ── 邮件（复用 301.group 的阿里云企业邮账号）─────────────
SMTP_HOST="smtp.qiye.aliyun.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="<USER>"
SMTP_PASSWORD="<PASSWORD>"
SMTP_FROM="AI 启智课 <no-reply@301.group>"

# ── AI 出图（提示词魔法工坊）──────────────────────────────
# 阿里云百炼/MaaS 的 OpenAI compatible-mode 地址（含 /v1，末尾不带斜杠）
AI_IMAGE_BASE_URL="https://<workspace>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
AI_IMAGE_API_KEY="sk-ws-<KEY>"
# z-image 系列走百炼原生 multimodal-generation（一次 1 张，后端按 n 并发）；
# qwen-image 系列走 OpenAI 兼容的 /images/generations（一次 4 张，较慢）。
AI_IMAGE_MODEL="z-image-turbo"

# ── 其他 ─────────────────────────────────────────────────
APP_ORIGIN="https://yuehua.online"
