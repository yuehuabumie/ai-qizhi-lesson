# Trusted worker host only, mode 0600. Never mount this file inside execution containers.
PREP_WORKER_SECRET=replace-with-the-same-random-secret-as-the-primary-api-at-least-32-characters
PREP_CORE_URL=http://127.0.0.1:3332/api/prep/internal
PREP_DATA_DIR=/var/lib/aiq-prep
PREP_IMAGE=aiq-prep:1
PREP_NETWORK=aiq-prep
PREP_BRIDGE_IP=172.30.223.1
PREP_CONCURRENCY=1
PREP_MAX_MODEL_CALLS=100
# Administrator-owned JSON (root:root 0600). Never mounted inside execution containers.
# Empty/unset means no external MCP services. PREP_ADMIN_PATCH is no longer supported.
# PREP_MCP_CONFIG=/etc/aiq-prep/mcp.json
