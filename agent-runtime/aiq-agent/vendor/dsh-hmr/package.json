{
  "name": "@deepseek-ai/dsh-hmr",
  "description": "Coordinated module and profile configuration hot reload",
  "version": "0.2.1-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/boot/hmr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-timer": "~1.1.7",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.2.1-rc.2"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "5.0.0",
    "node-addon-require-builtin": "^0.1.9",
    "picomatch": "^4.0.7",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "private": true
}
